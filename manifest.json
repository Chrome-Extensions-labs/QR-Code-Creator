{
  "manifest_version": 3,
  "name": "QR Code Creator",
  "description": "Pixel-art QR generator with presets, hover previews, reverse scanner, and retro UI.",
  "version": "1.0.0",

  "action": {
    "default_title": "QR Code Creator",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "notifications",
    "tabs",
    "clipboardWrite"
  ],

  "host_permissions": [
    "*://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "libs/qr-code-styling.min.js",
        "content.js",
        "hover_engine.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "libs/qr-code-styling.min.js",
        "libs/jsqr.js",
        "icons/*"
      ],
      "matches": ["*://*/*"]
    }
  ]
}
